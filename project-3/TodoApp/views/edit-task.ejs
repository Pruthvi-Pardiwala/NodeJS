<%- include('partials/header') %>

<div class="page-wrapper">
  <div class="container-fluid px-4 py-4">

    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb custom-breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item active">Edit Task #<%= task.id.toString().padStart(3,'0') %></li>
      </ol>
    </nav>

    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <div class="form-card">
          <div class="form-card-header">
            <div class="form-header-icon edit-icon"><i class="bi bi-pencil-square"></i></div>
            <div>
              <h4 class="form-card-title">Edit Task</h4>
              <p class="form-card-sub">
                Task ID:
                <span class="task-id-badge">#<%= task.id.toString().padStart(3,'0') %></span>
                &nbsp;|&nbsp; Current status:
                <span class="badge status-badge status-<%= task.status.toLowerCase().replace(' ','-') %>">
                  <%= task.status %>
                </span>
              </p>
            </div>
          </div>

          <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center gap-2 mx-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span><%= error %></span>
          </div>
          <% } %>

          <form action="/edit/<%= task.id %>" method="POST" class="form-body">

            <div class="mb-4">
              <label class="form-label-custom" for="title">
                <i class="bi bi-type me-1"></i>Task Title <span class="required-star">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                class="form-control form-control-custom"
                value="<%= task.title %>"
                required
                maxlength="100"
              />
            </div>

            <div class="mb-4">
              <label class="form-label-custom" for="description">
                <i class="bi bi-text-paragraph me-1"></i>Description
              </label>
              <textarea
                id="description"
                name="description"
                class="form-control form-control-custom"
                rows="3"
                maxlength="300"
              ><%= task.description %></textarea>
            </div>

            <div class="row g-3 mb-5">
              <div class="col-6">
                <label class="form-label-custom" for="priority">
                  <i class="bi bi-flag me-1"></i>Priority
                </label>
                <select id="priority" name="priority" class="form-select form-control-custom">
                  <option value="Low" <%= task.priority === 'Low' ? 'selected' : '' %>>🔽 Low</option>
                  <option value="Medium" <%= task.priority === 'Medium' ? 'selected' : '' %>>➡️ Medium</option>
                  <option value="High" <%= task.priority === 'High' ? 'selected' : '' %>>🔼 High</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label-custom" for="status">
                  <i class="bi bi-activity me-1"></i>Status
                </label>
                <select id="status" name="status" class="form-select form-control-custom">
                  <option value="Pending" <%= task.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                  <option value="In Progress" <%= task.status === 'In Progress' ? 'selected' : '' %>>🔄 In Progress</option>
                  <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>✅ Completed</option>
                </select>
              </div>
            </div>

            <div class="form-actions">
              <a href="/" class="btn btn-ghost-custom">
                <i class="bi bi-arrow-left me-2"></i>Cancel
              </a>
              <button type="submit" class="btn btn-primary-custom">
                <i class="bi bi-save me-2"></i>Save Changes
              </button>
            </div>

          </form>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
